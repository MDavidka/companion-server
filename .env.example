# ============================================
# Sycord M1 Instance - Environment Variables
# ============================================

# Server
PORT=4500
AUTO_UPDATE=true

# MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=main
MONGO_COLLECTION=users

# Cloudflare (optional, for DNS record creation and tunnel ingress)
CLOUDFLARE_API_KEY=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_DOMAIN=sycord.site

# Cloudflare Tunnel (optional, for automatic tunnel ingress rules)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARED_TUNNEL_ID=your_cloudflare_tunnel_id

# GitHub (fallback token used when a repo document has no git_token)
GITHUB_API_TOKEN=your_github_personal_access_token

# MongoDB Configuration
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB=main
MONGO_COLLECTION=users

# Cloudflare DNS Configuration (optional – only needed for automatic DNS CNAME record creation)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Zone ID for DNS record creation (find in your Cloudflare dashboard, Overview page of the domain)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# Root domain used when creating DNS CNAME records (e.g. <project>.sycord.site)
CLOUDFLARE_DOMAIN=sycord.site

# Server Configuration
SERVER_HOST=sycord.site
PORT=5000
DEBUG=False


# MongoDB Configuration
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB=main
MONGO_COLLECTION=users

# Cloudflare DNS Configuration (optional – only needed for automatic DNS CNAME record creation)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
# Zone ID for DNS record creation (find in your Cloudflare dashboard, Overview page of the domain)
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
# Root domain used when creating DNS CNAME records (e.g. <project>.sycord.site)
CLOUDFLARE_DOMAIN=sycord.site

# Cloudflare Tunnel (cloudflared) — required to route localhost:<port> directly
# through a tunnel instead of relying on a public CNAME → SERVER_HOST hop.
# When BOTH of these are set the deploy pipeline writes ingress rules into the
# tunnel: { hostname: <project>.<CLOUDFLARE_DOMAIN>, service: http://localhost:<port> }
# and updates the DNS CNAME to <TUNNEL_ID>.cfargotunnel.com (proxied).
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARED_TUNNEL_ID=your_tunnel_uuid

# Server Configuration
SERVER_HOST=sycord.site
PORT=5000
DEBUG=False


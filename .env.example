# MongoDB Configuration
MONGO_URI=mongodb+srv://user:password@cluster0.mongodb.net/?appName=Cluster0
MONGO_DB=main
MONGO_COLLECTION=users

# Runner Configuration
PORT=4500
CLOUDFLARE_DOMAIN=sycord.site
SERVER_HOST=sycord.site

# Routing model:
#   A single wildcard Cloudflare Tunnel routes *.sycord.site → http://localhost:4500
#   The runner's proxy middleware then dispatches <project>.sycord.site to the
#   correct local port using registry.json. No per-site tunnel/DNS edits.
#
# Tunnel config (on the host, NOT this app):
#   ~/.cloudflared/config.yml
#     tunnel: <TUNNEL_ID>
#     credentials-file: /root/.cloudflared/<TUNNEL_ID>.json
#     ingress:
#       - hostname: "*.sycord.site"
#         service: http://localhost:4500
#       - hostname: sycord.site
#         service: http://localhost:4500
#       - service: http_status:404
#
# Per-project Cloudflare API variables are NOT required:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARED_TUNNEL_ID=
